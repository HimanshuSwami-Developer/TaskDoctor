# Neon → your project → Connection string (Node.js). Keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# Cloudinary (screen images) → cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=task-doctor

# First super admin (created on start if there is no super admin yet). Use a strong password.
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=

# Address people open the app at, used for the "Open in FlowTrace" buttons in Teams messages
# (the daily sanity reminder needs it; other messages fall back to the address the request came in on)
APP_URL=
# Team's timezone: sanity resets at midnight here and reminders follow this clock (default Asia/Kolkata)
APP_TIMEZONE=Asia/Kolkata

# Send from your own Microsoft Teams (direct messages, your chats and group chats, issue messages) — Microsoft Entra admin center →
# App registrations → your app → Overview. Platform "Single-page application" with redirect URI = APP_URL + "/"
# (and http://localhost:4000/ for local use). Delegated permissions: User.Read, User.ReadBasic.All, Chat.Create,
# Chat.ReadBasic, ChatMessage.Send. Both values are public ids, not secrets.
MS_CLIENT_ID=
MS_TENANT_ID=
