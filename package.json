{
  "name": "flowtrace",
  "version": "1.0.0",
  "description": "FlowTrace — product modules, flows, screens, conditions and issues, stored in Neon Postgres",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "lsof -ti :4000 | xargs kill -9 2>/dev/null; nodemon --env-file-if-exists=.env --watch server.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "nodemon": "^3.1.14",
    "pg": "^8.23.0"
  },
  "author": "Himanshu Swami (FinDevelopers, prompting)",
  "contributors": [
    "Vishal Yadav (idea & prompts)"
  ]
}
