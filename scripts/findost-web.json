    {
      "name": "Auth",
      "flows": [
        {
          "name": "Login with OTP",
          "screens": [
            {
              "name": "Login to FinDost (OTP)",
              "page": "/auth/login-with-otp",
              "kind": "screen",
              "action": "",
              "wireframe": "form"
            },
            {
              "name": "Verify OTP",
              "page": "/auth/verify-otp",
              "kind": "screen",
              "action": "Click \"Send OTP\" on Login with OTP",
              "wireframe": "form"
            },
            {
              "name": "OTP Verification Complete!",
              "page": "/auth/verify-otp",
              "kind": "screen",
              "action": "OTP verified for a user whose status is Init (shown under the DRA Registration dialog)",
              "wireframe": "detail"
            },
            {
              "name": "DRA Registration",
              "page": "/auth/verify-otp",
              "kind": "popup",
              "action": "Opens on its own after OTP verify when user status is Init",
              "wireframe": "form"
            },
            {
              "name": "Form Submitted Successfully!",
              "page": "/auth/verify-otp",
              "kind": "popup",
              "action": "Click \"Submit\" in DRA Registration; its button goes to /auth/login-with-otp",
              "wireframe": "detail"
            }
          ]
        },
        {
          "name": "Login with Password",
          "screens": [
            {
              "name": "Login to FinDost (Password)",
              "page": "/auth/login",
              "kind": "screen",
              "action": "Click \"Login with Password\" link; on success goes to /dashboard",
              "wireframe": "form"
            }
          ]
        },
        {
          "name": "Forget Password",
          "screens": [
            {
              "name": "Forget Password?",
              "page": "/auth/forget-password",
              "kind": "screen",
              "action": "Click \"Forget Password?\" on /auth/login",
              "wireframe": "form"
            },
            {
              "name": "Verify OTP (Forget Password)",
              "page": "/auth/forget-password/otp",
              "kind": "screen",
              "action": "Submit Forget Password form",
              "wireframe": "form"
            },
            {
              "name": "Forget Password? (Change Password)",
              "page": "/auth/change-password",
              "kind": "screen",
              "action": "OTP verified; on submit goes to /auth/login",
              "wireframe": "form"
            }
          ]
        },
        {
          "name": "DRA Sign Up",
          "screens": [
            {
              "name": "Sign Up as Digital Parnter (DRA)",
              "page": "/auth/login-with-otp",
              "kind": "popup",
              "action": "Auto-opens when arriving with state.openSignup (also from the Marketing page)",
              "wireframe": "form"
            },
            {
              "name": "Verify OTP (Sign Up)",
              "page": "/auth/login-with-otp",
              "kind": "popup",
              "action": "Submit phone number in the Sign Up popup",
              "wireframe": "form"
            },
            {
              "name": "DRA Registration",
              "page": "/auth/login-with-otp",
              "kind": "popup",
              "action": "Click \"Verify OTP\"",
              "wireframe": "form"
